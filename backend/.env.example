APP_NAME=Resume Job Workbench
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/workbench.db

# OpenAI-compatible LLM. For local Ollama, set base URL and leave key empty.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Delivery safety settings
MIN_DELIVERY_INTERVAL_SECONDS=40
FINGERPRINT_SPOOFING_ENABLED=false
BROWSER_HEADLESS=true
